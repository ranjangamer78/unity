<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:fitsSystemWindows="true">

    <!-- ============================================== -->
    <!-- TOP BANNER CONTAINER (Dedicated, Non-collapsible)-->
    <!-- Pinned strictly to top edge                    -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/topBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:minHeight="60dp"
        android:background="@drawable/bg_banner_container"
        android:foregroundGravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status & Diagnostic Text (Always visible during loading or if failed) -->
        <TextView
            android:id="@+id/tvTopBannerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="[ Loading Top Banner (320x50)... ]" />

        <!-- Dedicated Banner Ad Holder (Strictly 320x50dp to prevent layout shifts) -->
        <FrameLayout
            android:id="@+id/topBannerAdHolder"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============================================== -->
    <!-- BOTTOM BANNER CONTAINER (Dedicated, Non-collapsible)-->
    <!-- Pinned strictly to bottom edge                 -->
    <!-- ============================================== -->
    <FrameLayout
        android:id="@+id/bottomBannerContainer"
        android:layout_width="match_parent"
        android:layout_height="62dp"
        android:minHeight="60dp"
        android:background="@drawable/bg_banner_container"
        android:foregroundGravity="center"
        android:layout_marginStart="8dp"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="8dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <!-- Status & Diagnostic Text (Always visible during loading or if failed) -->
        <TextView
            android:id="@+id/tvBottomBannerStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:textColor="@color/text_secondary"
            android:textSize="12sp"
            android:gravity="center"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:text="[ Loading Bottom Banner (320x50)... ]" />

        <!-- Dedicated Banner Ad Holder (Strictly 320x50dp to prevent layout shifts) -->
        <FrameLayout
            android:id="@+id/bottomBannerAdHolder"
            android:layout_width="320dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:visibility="gone" />
    </FrameLayout>

    <!-- ============================================== -->
    <!-- MAIN CONTENT SCROLLER                          -->
    <!-- Pinned strictly between Top & Bottom Banners   -->
    <!-- Banners will NEVER overlap or cover buttons    -->
    <!-- ============================================== -->
    <androidx.core.widget.NestedScrollView
        android:id="@+id/middleScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/topBannerContainer"
        app:layout_constraintBottom_toTopOf="@id/bottomBannerContainer"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="12dp"
            android:gravity="center_horizontal">

            <!-- APP HEADER -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center_horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvAppTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_title"
                    android:textColor="@color/text_primary"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.05" />

                <TextView
                    android:id="@+id/tvAppSubtitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/app_subtitle"
                    android:textColor="@color/text_secondary"
                    android:textSize="12sp"
                    android:layout_marginTop="2dp" />

                <!-- Config Badge -->
                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:background="@drawable/bg_badge"
                    android:paddingStart="10dp"
                    android:paddingEnd="10dp"
                    android:paddingTop="4dp"
                    android:paddingBottom="4dp"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical">

                    <TextView
                        android:id="@+id/tvGameIdBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Game ID: 5846818"
                        android:textColor="@color/primary_container"
                        android:textSize="11sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" • "
                        android:textColor="@color/text_secondary"
                        android:textSize="11sp" />

                    <TextView
                        android:id="@+id/tvTestModeBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="REAL ADS MODE"
                        android:textColor="@color/status_ready"
                        android:textSize="11sp"
                        android:textStyle="bold" />
                </LinearLayout>
            </LinearLayout>

            <!-- CURRENT IP ADDRESS & CURRENT COUNTRY CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="DEVICE NETWORK &amp; LOCATION"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/btnRefreshGeoIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Refresh"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:textStyle="bold"
                        android:padding="4dp" />
                </LinearLayout>

                <!-- Current IP Address -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Current IP:"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCurrentIp"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detecting IP..."
                        android:textColor="@color/text_primary"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        android:fontFamily="monospace" />
                </LinearLayout>

                <!-- Current Country -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="4dp">

                    <TextView
                        android:layout_width="110dp"
                        android:layout_height="wrap_content"
                        android:text="Current Country:"
                        android:textColor="@color/text_secondary"
                        android:textSize="13sp" />

                    <TextView
                        android:id="@+id/tvCurrentCountry"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Detecting Country..."
                        android:textColor="@color/secondary"
                        android:textSize="13sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* Live Unity Ads inventory is geo-targeted to your detected country."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:layout_marginTop="6dp" />
            </LinearLayout>

            <!-- UNITY ADS CONTROLLER CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="UNITY ADS CONTROLLER"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnQuickReloadAll"
                        android:layout_width="wrap_content"
                        android:layout_height="38dp"
                        android:text="RELOAD ALL ADS"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        app:cornerRadius="8dp"
                        style="@style/Widget.Material3.Button.TonalButton"
                        android:backgroundTint="@color/surface_card"
                        android:textColor="@color/primary_container"
                        android:insetTop="0dp"
                        android:insetBottom="0dp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="10dp">

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tvAdModeTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Test Ads Mode (Active)"
                            android:textColor="@color/text_primary"
                            android:textSize="14sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/tvAdModeDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Guarantees 100% ad fill rate for APK testing on real phone"
                            android:textColor="@color/text_secondary"
                            android:textSize="11sp"
                            android:layout_marginTop="2dp" />
                    </LinearLayout>

                    <com.google.android.material.materialswitch.MaterialSwitch
                        android:id="@+id/switchTestMode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:checked="true" />
                </LinearLayout>
            </LinearLayout>

            <!-- REWARDS & STATE CARD -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="14dp"
                android:layout_marginBottom="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="REWARD SYSTEM"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.08" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginTop="6dp">

                    <TextView
                        android:id="@+id/tvCoins"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Rewards Earned: 0 Coins"
                        android:textColor="@color/text_primary"
                        android:textSize="17sp"
                        android:textStyle="bold" />

                    <TextView
                        android:id="@+id/tvRewardCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="0 ads completed"
                        android:textColor="@color/secondary"
                        android:textSize="12sp"
                        android:textStyle="bold" />
                </LinearLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="* Verified rewards are only awarded after Unity confirms 100% ad completion."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="4dp" />
            </LinearLayout>

            <!-- ACTION BUTTONS SECTION -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="14dp">

                <!-- 1. SHOW INTERSTITIAL AD BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnShowInterstitial"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_show_interstitial"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/primary"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tvInterstitialStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Status: Initializing..."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- 2. WATCH REWARDED AD BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnWatchRewarded"
                    android:layout_width="match_parent"
                    android:layout_height="56dp"
                    android:text="@string/btn_watch_rewarded"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:cornerRadius="10dp"
                    android:backgroundTint="@color/secondary"
                    android:textColor="@color/white"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tvRewardedStatus"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Status: Initializing..."
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- 3. RELOAD BANNERS BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnReloadBanners"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="RELOAD BANNER ADS"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    app:cornerRadius="10dp"
                    style="@style/Widget.Material3.Button.TonalButton"
                    android:textColor="@color/primary_container"
                    android:backgroundTint="@color/surface_card"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:id="@+id/tvBannerStatusSummary"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Top &amp; Bottom Banners: Initializing..."
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp"
                    android:layout_marginBottom="12dp" />

                <!-- 4. RESTART APP BUTTON -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btnRestartApp"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:text="@string/btn_restart_app"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:letterSpacing="0.04"
                    app:cornerRadius="10dp"
                    style="@style/Widget.Material3.Button.OutlinedButton"
                    app:strokeColor="@color/danger"
                    app:strokeWidth="1.5dp"
                    android:textColor="@color/danger"
                    android:insetTop="0dp"
                    android:insetBottom="0dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Clears app data &amp; restarts from first launch"
                    android:textColor="@color/text_tertiary"
                    android:textSize="11sp"
                    android:layout_marginTop="3dp" />
            </LinearLayout>

            <!-- REAL-TIME SDK EVENT LOG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@drawable/bg_card"
                android:padding="12dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="LIVE AD EVENT LOG"
                        android:textColor="@color/text_tertiary"
                        android:textSize="11sp"
                        android:textStyle="bold"
                        android:letterSpacing="0.08" />

                    <TextView
                        android:id="@+id/btnClearLog"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Clear"
                        android:textColor="@color/primary"
                        android:textSize="12sp"
                        android:padding="4dp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/tvLiveLog"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="70dp"
                    android:maxLines="10"
                    android:textColor="@color/text_secondary"
                    android:textSize="11sp"
                    android:fontFamily="monospace"
                    android:layout_marginTop="6dp"
                    android:text="[Ready] Waiting for SDK events..." />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
